#!/usr/bin/env python3
"""Stand-in for `claude -p … --output-format stream-json` in the engine tests.

The prompt says what to do (`/sdlc:go --item <slug> --design|--build|--fix`, `--self-check`, or a resume prompt that names
the same). What actually happens is scripted per `<slug>:<phase>` in $STUB_CLAUDE_SCENARIO (a list of actions consumed in
order; `ok` once it runs out). Every call is appended to $STUB_CLAUDE_CALLS (the command line too, as `args`); the cost of a
session id accumulates across resumes in $STUB_CLAUDE_STATE, like the real total_cost_usd does.

`--help` lists --setting-sources and --strict-mcp-config like a current claude; $STUB_CLAUDE_HIDE_FLAGS (comma-separated, say
"--setting-sources,--strict-mcp-config") drops those lines, as an older claude would not have them.

Actions beyond the obvious ones (`<name>[:<text after the colon>]`): `fix_blocked:<why>` is a fix session that cannot fix it — it
writes <why> under Departures, commits that, and prints `SDLC_FIX_BLOCKED <why>` instead of SDLC_FIXED (no text: the bare marker);
`fix_blocked_dirty:<why>` the same with the note left uncommitted in the tree.

A build session calls the reviewer subagent (an `assistant` event with a `tool_use` of `Agent`, input `subagent_type:
"sdlc:sdlc-reviewer"`) unless the action says it does not: `no_review` is a build that skips the review and writes the tally
anyway. A fix session calls it when its brief says the review did not run in a fresh context (what references/fix.md has it do),
or always with `fix_review`. `subagent:<type>[:<tool name>]` is a build that calls that subagent instead of the reviewer, by the
tool's name (`Agent` by default, `Task` as an older Claude Code calls it). A self-check session writes the files of the scenario's
`selfcheck_write` ({path: text}), stages the ones in `selfcheck_stage` and changes the ones in `selfcheck_touch` (paths of
tracked files), besides the work docs of `selfcheck_docs`; `max_turns` in that phase leaves the same behind.
`person_push[:<file>]` is a build, and somebody else pushing a commit to origin's sdlc/<slug> while it ran.
"""
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time

args = sys.argv[1:]
if args[:1] == ["--help"]:
    hide = [f for f in os.environ.get("STUB_CLAUDE_HIDE_FLAGS", "").split(",") if f]
    lines = ["Usage: claude [options] [command] [prompt]", "  --permission-prompts <mode>", "  --max-budget-usd <amount>",
             "  --plugin-dir <path>", "  --setting-sources <sources>", "  --strict-mcp-config"]
    print("\n".join(l for l in lines if not any(f in l for f in hide)))
    sys.exit(0)
if args[:1] == ["--version"]:
    print("9.9.9 (Claude Code stub)")
    sys.exit(0)


def opt(name, default=""):
    if name in args:
        i = args.index(name)
        return args[i + 1] if i + 1 < len(args) else default
    return default


def load(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError, TypeError):
        return default


def save(path, data):
    if path:
        with open(path, "w") as fh:
            json.dump(data, fh)


def emit(ev):
    sys.stdout.write(json.dumps(ev) + "\n")
    sys.stdout.flush()


def git(*a):
    return subprocess.run(["git"] + list(a), capture_output=True, text=True)


prompt = opt("-p")
sid = opt("--session-id") or opt("--resume")
resumed = "--resume" in args
model = opt("--model") or "default"
m = re.search(r"--item (\S+) --(design|build|fix)", prompt)
if m:
    slug, phase = m.group(1), m.group(2)
elif "--self-check" in prompt:
    slug, phase = "", "self-check"
else:
    slug, phase = "", "other"
key = "%s:%s" % (slug, phase) if slug else phase

state_path = os.environ.get("STUB_CLAUDE_STATE", "")
state = load(state_path, {"cost": {}, "used": {}})
scen = load(os.environ.get("STUB_CLAUDE_SCENARIO", ""), {})
todo = scen.get(key, [])
n = state["used"].get(key, 0)
action = todo[n] if n < len(todo) else "ok"
state["used"][key] = n + 1
cost = round(state["cost"].get(sid, 0.0) + float(scen.get("cost_step", 0.5)), 4)
state["cost"][sid] = cost
save(state_path, state)

calls = os.environ.get("STUB_CLAUDE_CALLS")
if calls:
    with open(calls, "a") as fh:
        fh.write(json.dumps({"key": key, "action": action, "sid": sid, "resumed": resumed, "model": model,
                             "effort": opt("--effort") or "", "budget": opt("--max-budget-usd"), "prompt": prompt, "args": args,
                             "claudecode": os.environ.get("CLAUDECODE"), "cwd": os.getcwd(),
                             "branch": git("symbolic-ref", "--short", "-q", "HEAD").stdout.strip()}) + "\n")

name, _, param = action.partition(":")
emit({"type": "system", "subtype": "init", "session_id": sid, "model": model,
      "plugins": [] if name == "no_plugin" else [{"name": "sdlc", "path": "/stub"}]})

doc_path = os.path.join("work", slug + ".md") if slug else ""


def read_doc():
    with open(doc_path, encoding="utf-8") as fh:
        return fh.read()


def write_doc(text):
    with open(doc_path, "w", encoding="utf-8") as fh:
        fh.write(text)


def set_status(text, status):
    return re.sub(r"(?m)^status:.*$", "status: " + status, text, count=1)


def add_section(text, title, body):
    if re.search(r"(?m)^## %s\s*$" % re.escape(title), text):
        return re.sub(r"(?ms)^## %s\s*$.*?(?=^## |\Z)" % re.escape(title), "## %s\n%s\n\n" % (title, body), text)
    return text.rstrip("\n") + "\n\n## %s\n%s\n" % (title, body)


def commit(msg):
    # a session commits what it wrote, not the bytecode and caches that running tests leaves behind
    git("add", "-A", "--", ".", ":(exclude).sdlc/state", ":(exclude).sdlc/logs", ":(exclude,glob)**/__pycache__/**",
        ":(exclude,glob)**/*.pyc", ":(exclude,glob)**/.pytest_cache/**")
    git("commit", "-q", "-m", msg)


def result(text, subtype="success", is_error=False, api_error=None, rc=0, terminal="completed"):
    emit({"type": "result", "subtype": subtype, "is_error": is_error, "result": text, "session_id": sid, "num_turns": 3,
          "total_cost_usd": cost, "modelUsage": {"claude-%s" % model: {"outputTokens": 10}}, "permission_denials": [],
          "api_error_status": api_error, "terminal_reason": terminal})
    sys.exit(rc)


def design():
    t = read_doc()
    t = add_section(t, "Plan", "1. Write src/%s.txt — checked by the test command." % slug)
    t = add_section(t, "Proof", "| R | check | kind |\n|---|---|---|\n| R1 | test command | auto |")
    write_doc(set_status(t, "planned"))
    commit("design %s" % slug)


def call_subagent(kind, tool="Agent"):
    """What a session's stream shows when it calls a subagent: an `assistant` event whose message has a tool_use block."""
    emit({"type": "assistant", "session_id": sid, "message": {"id": "msg_stub", "role": "assistant", "content": [
        {"type": "text", "text": "calling the subagent"},
        {"type": "tool_use", "id": "toolu_stub", "name": tool, "input": {"description": "stub", "subagent_type": kind,
                                                                           "prompt": "do it"}}]}})


def build(important=0, tally=True, extra=None, review=True, agent=None):
    if agent:
        call_subagent(*agent)
    elif review:
        call_subagent("sdlc:sdlc-reviewer")
    os.makedirs("src", exist_ok=True)
    with open(os.path.join("src", slug + ".txt"), "w") as fh:
        fh.write("built %s\n" % slug)
    if extra:
        extra()
    t = read_doc()
    if tally:
        t = add_section(t, "Review", "SDLC_REVIEW_TALLY important=%d nits=1 validated=yes" % important)
    write_doc(set_status(t, "built"))
    commit("build %s" % slug)


def fix(review=None):
    if review is None:
        review = "did not run in a fresh context" in prompt
    if review:
        call_subagent("sdlc:sdlc-reviewer")
    if "conflicts" in prompt:
        base = re.search(r"`git merge (\S+)` conflicts", prompt).group(1)
        git("merge", "-q", "-X", "ours", "--no-edit", base)
    if os.path.exists("FAIL"):
        git("rm", "-q", "FAIL")
    t = read_doc()
    if "SDLC_REVIEW_TALLY" not in t or re.search(r"important=[1-9]", t):
        t = add_section(t, "Review", "SDLC_REVIEW_TALLY important=0 nits=1 validated=yes")
        write_doc(t)
    with open("FIXED-%s" % slug, "a") as fh:
        fh.write("fixed\n")
    commit("fix %s" % slug)


def weaken_test():
    """An in-place edit of the existing test that keeps the number of cases and assertions (test integrity alone passes it)."""
    with open("tests/test_base.py", encoding="utf-8") as fh:
        t = fh.read()
    with open("tests/test_base.py", "w", encoding="utf-8") as fh:
        fh.write(t.replace("assert 1 + 1 == 2", "assert True"))


def touch_file(path):
    """Change a file the way a session loosening its own guardrails would: a JSON file gets a key, anything else a line."""
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    if path.endswith(".json"):
        try:
            with open(path, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            data = {}
        data["_stub_touched"] = True
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2)
    else:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write("# touched by the stub\n")


def on_sigint(signum, frame):
    sys.exit(130)


def on_sigint_graceful(signum, frame):
    # what the real claude does on SIGINT: ends the turn and still writes a result — it looks like a success, with no
    # text, and says only in terminal_reason that it was cut short
    result("", terminal="aborted_streaming")


def patch_config(patch):
    """Merge a JSON patch into .sdlc/config.json (a null value removes the key) — the skeleton item filling commands.*."""
    path = os.path.join(".sdlc", "config.json")
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)

    def merge(a, b):
        for k, v in b.items():
            if v is None:
                a.pop(k, None)
            elif isinstance(v, dict) and isinstance(a.get(k), dict):
                merge(a[k], v)
            else:
                a[k] = v
    merge(data, patch)
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")


def write_raw(path, text):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)


def selfcheck_work(n):
    """What a self-check session leaves in the tree (the first one only): files from `selfcheck_write` ({path: text}), the
    staging of `selfcheck_stage` (paths), changes to the tracked files of `selfcheck_touch`, the work docs of `selfcheck_docs`."""
    if n != 0:
        return
    for path, text in scen.get("selfcheck_write", {}).items():
        write_raw(path, text)
    for path in scen.get("selfcheck_stage", []):
        git("add", "--", path)
    for path in scen.get("selfcheck_touch", []):
        touch_file(path)
    for d in scen.get("selfcheck_docs", []):
        with open(os.path.join("work", d["slug"] + ".md"), "w") as fh:
            fh.write("---\nslug: %s\ntitle: %s\nstatus: %s\n---\n\n## Goal\n%s\n" % (
                d["slug"], d.get("title", d["slug"]), d.get("status", "ready"), d.get("goal", "Fix a finding.")))


if name == "sleep":
    signal.signal(signal.SIGINT, on_sigint)
    time.sleep(float(param or 30))
    name = "ok"
elif name == "sleep_graceful":
    signal.signal(signal.SIGINT, on_sigint_graceful)
    time.sleep(float(param or 30))
    name = "ok"

if name in ("ok", "no_plugin"):
    if phase == "design":
        design()
        result("done SDLC_PLANNED %s" % slug)
    elif phase == "build":
        build()
        result("done SDLC_BUILT %s" % slug)
    elif phase == "fix":
        fix()
        result("SDLC_FIXED")
    elif phase == "self-check":
        selfcheck_work(n)
        result("SDLC_SELFCHECK items=%d" % (len(scen.get("selfcheck_docs", [])) if n == 0 else 0))
    else:
        result("ok")
elif name in ("max_turns", "max_budget"):
    # the two caps that stop a session with its work resumable: the turn cap and the spend cap (--max-budget-usd)
    if phase == "self-check":                            # a self-check cut short has written what it had by then
        selfcheck_work(n)
    os.makedirs("src", exist_ok=True)
    with open(os.path.join("src", "%s-partial-%d.txt" % (slug, n)), "w") as fh:
        fh.write("partial\n")
    result("", subtype="error_max_turns" if name == "max_turns" else "error_max_budget_usd", is_error=True)
elif name in ("max_turns_noprogress", "max_budget_noprogress"):
    result("", subtype="error_max_turns" if name == "max_turns_noprogress" else "error_max_budget_usd", is_error=True)
elif name == "limit_session":
    emit({"type": "rate_limit_event", "rate_limit_info": {"status": "rejected", "rateLimitType": "five_hour",
                                                          "resetsAt": int(time.time() + float(param or 1))}})
    result("You've hit your session limit · resets 3pm (Asia/Seoul)", is_error=True)
elif name == "limit_opus":
    result("You've hit your Opus limit · resets 5pm (Asia/Seoul)", is_error=True)
elif name == "limit_sonnet":
    result("You've hit your Sonnet limit · resets 5pm (Asia/Seoul)", is_error=True)
elif name == "drop":
    # an item the session finds unnecessary: dropped, the text after the colon as the first line of Departures (without it
    # the template's hint stays, as when a session forgets to replace it)
    t = read_doc()
    if param:
        t = add_section(t, "Departures", param)
    elif "## Departures" not in t:
        t = add_section(t, "Departures", "<!-- Where the build departed from the plan, and why. -->")
    write_doc(set_status(t, "dropped"))
    commit("dropped %s" % slug)
    result("SDLC_DROPPED %s" % slug)
elif name == "needs_input":
    t = add_section(read_doc(), "Questions", "1. Which currency? (recommended: KRW)\n   - KRW\n   - USD")
    write_doc(set_status(t, "needs-input"))
    commit("question %s" % slug)
    result("SDLC_NEEDS_INPUT %s" % slug)
elif name == "design_empty":
    # the doc says planned, but Plan/Proof are missing (default), only hint comments (:comment) or Proof is missing (:plan)
    t = read_doc()
    if param == "comment":
        t = add_section(t, "Plan", "<!-- Filled by the design session: numbered steps. -->")
        t = add_section(t, "Proof", "<!-- | R | test or command | kind | -->")
    elif param == "plan":
        t = add_section(t, "Plan", "1. Write src/%s.txt." % slug)
    write_doc(set_status(t, "planned"))
    commit("design %s (empty)" % slug)
    result("done SDLC_PLANNED %s" % slug)
elif name == "error":
    result("something broke", subtype="error_during_execution", is_error=True)
elif name == "infra":
    result("API Error: Overloaded", subtype="error_during_execution", is_error=True, api_error=529)
elif name == "gave_up":
    result("I could not finish this.")
elif name == "silent":
    result("")                       # ended on its own, with nothing to say and the doc untouched
elif name == "aborted":
    result("", terminal=param or "aborted_streaming")    # cut short without anyone's signal
elif name == "aborted_after_work":
    if phase == "design":                                # the phase was done and committed; the result still says aborted
        design()
    elif phase == "build":
        build()
    result("", terminal="aborted_streaming")
elif name == "new_dep":
    def dep():
        with open("package.json") as fh:
            pj = json.load(fh)
        pj.setdefault("dependencies", {})["left-pad"] = "^1.3.0"
        with open("package.json", "w") as fh:
            json.dump(pj, fh, indent=2)
    build(extra=dep)
    result("SDLC_BUILT %s" % slug)
elif name == "fail_gate":
    def fail():
        with open("FAIL", "w") as fh:
            fh.write("the test command fails while this file exists\n")
    build(extra=fail)
    result("SDLC_BUILT %s" % slug)
elif name == "important":
    build(important=1)
    result("SDLC_BUILT %s" % slug)
elif name == "no_review":
    build(review=False)
    result("SDLC_BUILT %s" % slug)
elif name == "subagent":
    kind, tool = param, "Agent"                  # the type has a colon in it (`sdlc:sdlc-reviewer`): a trailing tool name is cut off
    head, _, last = param.rpartition(":")
    if last in ("Agent", "Task"):
        kind, tool = head, last
    build(agent=(kind, tool))
    result("SDLC_BUILT %s" % slug)
elif name == "fix_review":
    fix(review=True)
    result("SDLC_FIXED")
elif name == "person_push":
    build()
    # somebody else pushes a commit to origin's sdlc/<slug> while the session runs: from a clone of their own, on top of the
    # branch when origin has it, else on a branch cut from main
    origin = git("remote", "get-url", "origin").stdout.strip()
    work_dir = tempfile.mkdtemp(prefix="stub-person-")
    clone = os.path.join(work_dir, "c")
    br = "sdlc/" + slug
    subprocess.run(["git", "clone", "-q", origin, clone], capture_output=True)
    has = subprocess.run(["git", "-C", clone, "ls-remote", "--exit-code", "--heads", "origin", br], capture_output=True).returncode == 0
    subprocess.run(["git", "-C", clone, "checkout", "-q"] + (["-B", br, "origin/" + br] if has else ["-b", br]), capture_output=True)
    with open(os.path.join(clone, param or "PERSON.txt"), "w") as fh:
        fh.write("a person's commit\n")
    subprocess.run(["git", "-C", clone, "add", "-A"], capture_output=True)
    subprocess.run(["git", "-C", clone, "commit", "-q", "-m", "PERSON: a fix"], capture_output=True)
    subprocess.run(["git", "-C", clone, "push", "-q", "origin", "HEAD:refs/heads/" + br], capture_output=True)
    result("SDLC_BUILT %s" % slug)
elif name == "no_tally":
    build(tally=False)
    result("SDLC_BUILT %s" % slug)
elif name == "delete_test":
    build(extra=lambda: git("rm", "-q", "tests/test_base.py"))
    result("SDLC_BUILT %s" % slug)
elif name == "skip_test":
    def skip():
        with open("tests/test_base.py", "a") as fh:
            fh.write("\n@pytest.mark.skip\ndef test_later():\n    assert True\n")
    build(extra=skip)
    result("SDLC_BUILT %s" % slug)
elif name == "modify_test":
    build(extra=weaken_test)
    result("SDLC_BUILT %s" % slug)
elif name == "rename_test":
    build(extra=lambda: git("mv", "tests/test_base.py", "tests/test_renamed.py"))
    result("SDLC_BUILT %s" % slug)
elif name == "add_test":
    def add():
        fn = "test_%s" % slug.replace("-", "_")
        with open(os.path.join("tests", fn + ".py"), "w") as fh:
            fh.write("def %s():\n    assert 2 + 2 == 4\n" % fn)
    build(extra=add)
    result("SDLC_BUILT %s" % slug)
elif name == "unlock_tests":
    # what a build session that wants to edit existing tests would do: allow it in the doc, then edit
    def unlock():
        weaken_test()
        write_doc(re.sub(r"(?m)^test_changes:.*$", "test_changes: allowed", read_doc(), count=1))
    build(extra=unlock)
    result("SDLC_BUILT %s" % slug)
elif name == "touch":
    build(extra=lambda: touch_file(param))
    result("SDLC_BUILT %s" % slug)
elif name == "remove":
    build(extra=lambda: git("rm", "-q", param))
    result("SDLC_BUILT %s" % slug)
elif name == "config":
    build(extra=lambda: patch_config(json.loads(param)))
    result("SDLC_BUILT %s" % slug)
elif name == "config_fail":
    # the same, and the change leaves the project's test command (`test ! -f FAIL`) failing until a fix session removes FAIL
    def patch_and_fail():
        patch_config(json.loads(param))
        with open("FAIL", "w") as fh:
            fh.write("the test command fails while this file exists\n")
    build(extra=patch_and_fail)
    result("SDLC_BUILT %s" % slug)
elif name in ("fix_blocked", "fix_blocked_dirty"):
    # a fix session that cannot fix it (references/fix.md): what blocks it goes under Departures — committed, or left in the
    # tree — and the marker that ends the session says so, with the same text
    write_doc(add_section(read_doc(), "Departures", param or "the stub cannot fix this"))
    if name == "fix_blocked":
        commit("fix blocked %s" % slug)
    result("SDLC_FIX_BLOCKED %s" % param if param else "SDLC_FIX_BLOCKED")
elif name == "fix_config":
    # a fix session that corrects what the branch recorded in .sdlc/config.json
    patch_config(json.loads(param))
    with open("FIXED-%s" % slug, "a") as fh:
        fh.write("fixed\n")
    commit("fix %s" % slug)
    result("SDLC_FIXED")
elif name == "config_raw":
    build(extra=lambda: write_raw(os.path.join(".sdlc", "config.json"), param))
    result("SDLC_BUILT %s" % slug)
elif name == "change_acceptance":
    def change():
        t = read_doc()
        write_doc(add_section(t, "Acceptance criteria", "R1. WHEN anything THE SYSTEM SHALL do less."))
    build(extra=change)
    result("SDLC_BUILT %s" % slug)
elif name == "conflict":
    build()
    branch = git("symbolic-ref", "--short", "HEAD").stdout.strip()
    git("checkout", "-q", "main")
    os.makedirs("src", exist_ok=True)
    with open(os.path.join("src", slug + ".txt"), "w") as fh:
        fh.write("main's own version\n")
    git("add", "-A")
    git("commit", "-q", "-m", "main changes the same file")
    git("checkout", "-q", branch)
    result("SDLC_BUILT %s" % slug)
elif name == "dirty_built":
    build()
    with open("LEFTOVER-%s" % slug, "w") as fh:
        fh.write("left uncommitted\n")
    result("SDLC_BUILT %s" % slug)
else:
    result("unknown stub action %s" % action, subtype="error_during_execution", is_error=True, rc=1)
