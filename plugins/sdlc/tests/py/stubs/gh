#!/usr/bin/env python3
"""Stand-in for `gh` in the tests: pull requests in a JSON file ($STUB_GH_DB) against the repository's origin, which is a
local bare repo. `pr merge` really squash-merges into origin. $STUB_GH_MERGE_FAIL=1 makes merges fail.

For init and github-setup.sh: `auth status` succeeds unless the host is in $STUB_GH_LOGGED_OUT (comma list) and no
`auth login` for it has happened yet ($STUB_GH_LOGIN_FAIL makes the login fail); `repo view`
and `api repos/…` answer from the environment — $STUB_GH_COLLAB (a count, or `err`), $STUB_GH_PRIVATE (1/0),
$STUB_GH_RULESET_ID (an existing ruleset), $STUB_GH_RULESET_FAIL (the ruleset call is refused; `codeowner`: only a body that
asks for code-owner review), $STUB_GH_PATCH_FAIL (the repository settings call is refused), $STUB_GH_NO_REPO (`repo view`
finds no repository). Every call is kept in the db under "calls" (and the GH_HOST it ran with under "hosts"); the bodies sent
with `--input -` are kept under "inputs" as {"args": […], "stdin": "…"}.

For the PR checks (the forge's `checks`, `check_logs` and `merge_state`) everything is set in the db before the run, and a db
that holds only these keys is enough. `pr view <n> --json a,b` prints an object with the stored fields asked for and the
computed ones below. "statusCheckRollup" is played from the db key "checks", {head branch: [snapshot, …]}: a snapshot is what
gh prints for the field — a list of CheckRun {"__typename": "CheckRun", "name", "status", "conclusion", "detailsUrl",
"workflowName"} and StatusContext {"__typename": "StatusContext", "context", "state", "targetUrl"} entries, or null (a PR
without any checks). Each call that asks for the field returns the first snapshot and drops it while more than one remains,
so [pending, pending, pass] plays out over three calls and then stays pass; a head without an entry (or with []) has no CI:
[]. A snapshot may also be {"error": "text"} (that call fails with the text) or {"raw": "text"} (that call prints the text
instead of JSON). $STUB_GH_VIEW_FAIL=1 makes every `pr view` fail. "headRefOid" is the head branch's tip on origin;
db["head_lag"] = {head: N} makes a push show up late: after the tip moved, the next N views that ask for "headRefOid" still
answer the previous tip, and a "statusCheckRollup" asked in such a view answers the snapshot last served (the old commit's
checks) without playing the script on ("head_tips", "head_held" and "checks_last" are that bookkeeping). "mergeStateStatus"
is CLEAN unless the head branch is in the db list "behind": then it is BEHIND, and `pr merge` fails with GitHub's "Head
branch is out of date" — until the head's tip on origin has changed since the first refused merge (the tip seen then is kept
in "behind_seen"); the head then leaves the list and the merge goes through. `pr merge --match-head-commit <sha>` fails with GitHub's "Head branch was
modified" unless the head's tip on origin starts with <sha>. `pr list` rows carry what the db holds for each field asked for, so a
db PR with "isCrossRepository": true is one from a fork. `run view <id> --log-failed` prints
db["run_logs"][id] when it has one, else a few lines that name the run and end with an error line; an id in the db list
"run_view_fail" makes it fail instead. db["run_in_progress"] = {id: N} is a run that is still being finalized: its first N
`run view <id> --log-failed` calls print gh's "run <id> is still in progress; logs will be available when it is complete" to
stderr and exit 1 (the calls so far are counted in db["run_asked"]), and the log is printed from the next one on."""
import json
import os
import subprocess
import sys
import tempfile

args = sys.argv[1:]
DB = os.environ.get("STUB_GH_DB", "gh-db.json")


def load():
    try:
        with open(DB) as fh:
            db = json.load(fh)
    except (OSError, ValueError):
        db = {}
    db.setdefault("next", 1)
    db.setdefault("prs", [])
    db.setdefault("calls", [])
    return db


def save(db):
    with open(DB, "w") as fh:
        json.dump(db, fh, indent=1)


def opt(name, default=None):
    if name in args:
        i = args.index(name)
        return args[i + 1] if i + 1 < len(args) else default
    return default


def git(*a, cwd=None):
    return subprocess.run(["git"] + list(a), capture_output=True, text=True, cwd=cwd)


def find(db, n):
    for pr in db["prs"]:
        if str(pr["number"]) == str(n):
            return pr
    sys.stderr.write("no pull request %s\n" % n)
    sys.exit(1)


def origin_tip(head):
    r = git("ls-remote", "origin", "refs/heads/" + head)
    return r.stdout.split()[0] if r.returncode == 0 and r.stdout.strip() else ""


def behind(db, head, merging=False):
    """True while `head` is in db["behind"]. The listing lapses once the head's tip on origin differs from the tip the first
    refused merge saw — the branch was brought up to date and pushed. Only a merge (`merging`) notes that first tip, so a push
    before the first refusal (the PR being published again) does not lift it. The caller saves the db."""
    if head not in db.get("behind", []):
        return False
    seen = db.setdefault("behind_seen", {})
    tip = origin_tip(head)
    if head not in seen:
        if merging:
            seen[head] = tip
        return True
    if seen[head] == tip:
        return True
    db["behind"].remove(head)
    del seen[head]
    return False


def next_snapshot(db, head):
    """The next scripted snapshot of the head's checks: the first, dropped while more than one remains; [] with none."""
    snaps = db.get("checks", {}).get(head) or []
    if len(snaps) > 1:
        db["checks"][head] = snaps[1:]
    snap = snaps[0] if snaps else []
    db.setdefault("checks_last", {})[head] = snap
    return snap


def head_oid(db, head):
    """(the head GitHub reports for the PR, whether it is a stale one). A push shows up late: with db["head_lag"][head] = N, the
    N views after the head's tip on origin moved still report the previous tip. The caller saves the db."""
    tip = origin_tip(head)
    tips, held = db.setdefault("head_tips", {}), db.setdefault("head_held", {})
    prev = tips.get(head)
    tips[head] = tip
    n = db.get("head_lag", {}).get(head, 0)
    if head not in held and prev is not None and prev != tip and n > 0:
        held[head] = {"oid": prev, "left": n}
    if head not in held:
        return tip, False
    held[head]["left"] -= 1
    oid = held[head]["oid"]
    if held[head]["left"] <= 0:
        del held[head]
    return oid, True


db = load()
db.setdefault("calls", []).append(args)
db.setdefault("hosts", []).append(os.environ.get("GH_HOST", ""))
save(db)

if args[:2] == ["auth", "status"]:
    host = opt("--hostname", "github.com")
    sys.exit(1 if host in os.environ.get("STUB_GH_LOGGED_OUT", "").split(",") and host not in db.get("logged_in", []) else 0)
if args[:2] == ["auth", "login"]:                       # the device flow: a code to type in, then logged in (or not)
    sys.stdout.write("! First copy your one-time code: ABCD-1234\n- Press Enter to open the browser...\n")
    sys.stdout.flush()
    if os.environ.get("STUB_GH_LOGIN_FAIL"):
        sys.stdout.write("error: the code expired\n")
        sys.exit(1)
    db["logged_in"] = db.get("logged_in", []) + [opt("-h", "github.com")]
    save(db)
    sys.exit(0)
if args[:2] == ["label", "create"]:
    sys.exit(0)
if args[:2] == ["repo", "view"]:
    if os.environ.get("STUB_GH_NO_REPO"):
        sys.stderr.write("no git remotes found\n")
        sys.exit(1)
    if "--jq" in args:                                  # gh repo view --json nameWithOwner --jq .nameWithOwner
        print("acme/widgets")
    else:
        print(json.dumps({"isPrivate": os.environ.get("STUB_GH_PRIVATE", "1") == "1", "defaultBranchRef": {"name": "main"},
                          "owner": {"login": "acme"}, "visibility": "PRIVATE"}))
    sys.exit(0)
if args[:1] == ["api"]:
    path = next((a for a in args[1:] if a.startswith("repos/")), "")
    method = opt("-X", "GET")
    body = ""
    if "--input" in args:
        body = sys.stdin.read()
        db.setdefault("inputs", []).append({"args": args, "stdin": body})
        save(db)
    if path.endswith("/collaborators?per_page=100"):
        count = os.environ.get("STUB_GH_COLLAB", "1")
        if count == "err":
            sys.stderr.write('{"message": "Forbidden"}\n')
            sys.exit(1)
        print(count)
        sys.exit(0)
    if path.endswith("/rulesets") and method == "GET":
        if os.environ.get("STUB_GH_RULESET_ID"):
            print(os.environ["STUB_GH_RULESET_ID"])
        sys.exit(0)
    if "/rulesets" in path:                             # POST (create) or PUT (update)
        fail = os.environ.get("STUB_GH_RULESET_FAIL", "")
        if fail == "codeowner":
            fail = "x" if '"require_code_owner_review": true' in body else ""
        if fail:
            sys.stderr.write('{"message": "Upgrade to GitHub Pro or make this repository public to enable this feature.", "status": "403"}\n')
            sys.exit(1)
        print(json.dumps({"id": 1}))
        sys.exit(0)
    if method == "PATCH":                               # repository settings
        sys.exit(1 if os.environ.get("STUB_GH_PATCH_FAIL") else 0)
    sys.stderr.write("stub gh: unsupported api %s\n" % args)
    sys.exit(1)
if args[:2] == ["run", "view"] and len(args) > 2 and "--log-failed" in args:
    rid = args[2]
    if rid in [str(i) for i in db.get("run_view_fail", [])]:
        sys.stderr.write("failed to get run log: HTTP 404: Not Found (run %s)\n" % rid)
        sys.exit(1)
    if rid in [str(i) for i in db.get("run_in_progress", {})]:
        asked = db.setdefault("run_asked", {})
        asked[rid] = asked.get(rid, 0) + 1
        save(db)
        if asked[rid] <= int(db["run_in_progress"].get(rid, 0)):
            sys.stderr.write("run %s is still in progress; logs will be available when it is complete\n" % rid)
            sys.exit(1)
    text = db.get("run_logs", {}).get(rid)
    if text is None:
        text = ("build\tRun tests\t2026-10-14T10:00:00.0000000Z ##[group]Run make test\n"
                "build\tRun tests\t2026-10-14T10:00:01.0000000Z running the tests of run %s\n"
                "build\tRun tests\t2026-10-14T10:00:02.0000000Z FAILED tests/test_feature.py::test_feature - AssertionError\n"
                "build\tRun tests\t2026-10-14T10:00:03.0000000Z ##[error]Process completed with exit code 1.\n" % rid)
    sys.stdout.write(text if text.endswith("\n") else text + "\n")
    sys.exit(0)
if args[:1] != ["pr"]:
    sys.stderr.write("stub gh: unsupported %s\n" % args)
    sys.exit(1)

sub = args[1]
if sub == "list":
    head, state = opt("--head"), (opt("--state") or "open").upper()
    fields = (opt("--json") or "number").split(",")
    out = []
    for pr in db["prs"]:
        if head and pr["head"] != head:
            continue
        if state != "ALL" and pr["state"] != state:
            continue
        out.append({f: pr.get(f) for f in fields})
    def number(p):                                      # a db PR may hold a number that is no number: gh prints it as it is
        try:
            return int(p.get("number") or 0)
        except (TypeError, ValueError):
            return 0
    out.sort(key=lambda p: -number(p))
    lim = int(opt("--limit") or 30)
    print(json.dumps(out[:lim]))
elif sub == "view" and "--json" in args:
    if os.environ.get("STUB_GH_VIEW_FAIL") == "1":
        sys.stderr.write("HTTP 502: Bad Gateway (https://api.github.com/graphql)\n")
        sys.exit(1)
    pr = find(db, args[2])
    fields = opt("--json").split(",")
    out, stale = {}, False
    if "headRefOid" in fields:
        out["headRefOid"], stale = head_oid(db, pr["head"])
    for f in fields:
        if f == "statusCheckRollup":
            out[f] = db.get("checks_last", {}).get(pr["head"], []) if stale else next_snapshot(db, pr["head"])
        elif f == "mergeStateStatus":
            out[f] = "BEHIND" if behind(db, pr["head"]) else "CLEAN"
        elif f != "headRefOid":
            out[f] = pr.get(f)
    save(db)
    snap = out.get("statusCheckRollup")
    if isinstance(snap, dict) and "error" in snap:
        sys.stderr.write(str(snap["error"]) + "\n")
        sys.exit(1)
    if isinstance(snap, dict) and "raw" in snap:
        print(snap["raw"])
        sys.exit(0)
    print(json.dumps(out))
elif sub == "create":
    n = db["next"]
    db["next"] = n + 1
    url = "https://github.test/o/r/pull/%d" % n
    db["prs"].append({"number": n, "head": opt("--head"), "headRefName": opt("--head"), "base": opt("--base"),
                      "title": opt("--title"), "body": opt("--body"), "isDraft": "--draft" in args, "state": "OPEN",
                      "url": url, "labels": [], "reviews": [], "reviewDecision": "", "author": {"login": "me"},
                      "comments": []})
    save(db)
    print(url)
elif sub == "edit":
    pr = find(db, args[2])
    if opt("--body") is not None:
        pr["body"] = opt("--body")
    if opt("--add-label"):
        pr["labels"].append({"name": opt("--add-label")})
    save(db)
elif sub == "ready":
    find(db, args[2])["isDraft"] = False
    save(db)
elif sub == "comment":
    find(db, args[2])["comments"].append(opt("--body"))
    save(db)
elif sub == "close":
    pr = find(db, args[2])
    pr["state"] = "CLOSED"
    if opt("--comment") is not None:
        pr["comments"].append(opt("--comment"))
    save(db)
elif sub == "merge":
    pr = find(db, args[2])
    if os.environ.get("STUB_GH_MERGE_FAIL") == "1" or pr["state"] != "OPEN" or pr.get("isDraft"):
        sys.stderr.write("GraphQL: Pull request is not mergeable\n")
        sys.exit(1)
    want = opt("--match-head-commit")                   # the merge is refused when the head is not the commit asked for
    if want and not origin_tip(pr["head"]).startswith(want):
        sys.stderr.write("GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)\n")
        sys.exit(1)
    if behind(db, pr["head"], merging=True):            # the branch has to be brought up to date first
        save(db)
        sys.stderr.write("GraphQL: Head branch is out of date. Review and try the merge again. (mergePullRequest)\n")
        sys.exit(1)
    origin = git("remote", "get-url", "origin").stdout.strip()
    tmp = tempfile.mkdtemp(prefix="stub-gh-")
    clone = os.path.join(tmp, "c")
    steps = [git("clone", "-q", origin, clone), git("checkout", "-q", pr["base"], cwd=clone),
             git("merge", "--squash", "origin/" + pr["head"], cwd=clone),
             git("commit", "-q", "-m", "%s (#%d)" % (pr["title"], pr["number"]), cwd=clone),
             git("push", "-q", "origin", pr["base"], cwd=clone)]
    for r in steps:
        if r.returncode != 0:
            sys.stderr.write("merge failed: %s\n" % (r.stderr or r.stdout))
            sys.exit(1)
    if "--delete-branch" in args:
        git("push", "-q", "origin", "--delete", pr["head"], cwd=clone)
    pr["state"] = "MERGED"
    save(db)
else:
    sys.stderr.write("stub gh: unsupported pr %s\n" % sub)
    sys.exit(1)
