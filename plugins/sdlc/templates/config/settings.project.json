{
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add*)", "Bash(git commit*)", "Bash(git checkout*)", "Bash(git switch*)", "Bash(git worktree*)",
      "{{build_permission}}", "{{test_permission}}", "{{lint_permission}}"
    ],
    "deny": [
      "Read(.env*)", "Read(**/.env*)", "Read(./secrets/**)", "Read(**/secrets/**)",
      "Bash(git push --force*)", "Bash(git push -f*)"
    ]
  }
}
