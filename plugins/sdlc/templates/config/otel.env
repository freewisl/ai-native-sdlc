# OpenTelemetry for Claude Code — every session emits metrics/events to your observability stack.
# Source this in the shell, or put the same keys under "env" in managed settings (see JSON below).
# Docs: https://code.claude.com/docs/en/monitoring-usage
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp          # console | otlp | prometheus | none
export OTEL_LOGS_EXPORTER=otlp             # console | otlp | none
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc    # grpc | http/json | http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.example.com:4317
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer REPLACE_ME"
export OTEL_METRIC_EXPORT_INTERVAL=60000   # ms
export OTEL_LOGS_EXPORT_INTERVAL=5000      # ms
export OTEL_LOG_TOOL_DETAILS=1             # adds skill_name / tool parameters to tool events (skill invocations become visible)
# Emitted: claude_code.session.count · lines_of_code.count · pull_request.count · commit.count · cost.usage · token.usage ·
#          code_edit_tool.decision · active_time.total (attributes: skill.name, agent.name, plugin.name, marketplace.name)
# Events:  claude_code.user_prompt · tool_result (decision_source: hook) · tool_decision (source: "hook") · api_request · api_error
#
# Managed settings equivalent (managed-settings.json → "env"):
# { "env": { "CLAUDE_CODE_ENABLE_TELEMETRY": "1", "OTEL_METRICS_EXPORTER": "otlp", "OTEL_LOGS_EXPORTER": "otlp",
#            "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc", "OTEL_EXPORTER_OTLP_ENDPOINT": "http://collector.example.com:4317",
#            "OTEL_EXPORTER_OTLP_HEADERS": "Authorization=Bearer REPLACE_ME", "OTEL_LOG_TOOL_DETAILS": "1" } }
